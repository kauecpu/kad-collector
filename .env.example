# Copie para .env somente se usar um carregador local de variáveis.
# Nunca versione valores reais.
# As variáveis OpenAI abaixo pertencem ao fluxo legado `process` e não são
# usadas pela classificação canônica.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Provedores aceitos pela classificação canônica. Escolha apenas um por execução.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen3.7-plus
QWEN_BASE_URL=https://dashscope-us.aliyuncs.com/compatible-mode/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Ollama local. Não requer chave e aceita somente endpoint de loopback.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
KAD_DATABASE_URL=
